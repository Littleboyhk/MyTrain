# Example Environment File (DO NOT store real API keys here)
#
# Client-side (Flutter) — the legacy RapidAPI IRCTC path reads these via dotenv.
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# -----------------------------------------------------------------------------
# RailKit — SERVER-SIDE ONLY. Do NOT put the RailKit key in this .env or in the
# Flutter build: it would ship to every device. It lives as a Supabase Edge
# Function secret and is used only inside supabase/functions/railkit.
#
#   supabase secrets set RAILKIT_API_KEY=<your_railkit_key>
#
# The Flutter client calls the `railkit` Edge Function via Supabase; the key
# never leaves the server. See supabase/README.md.
# -----------------------------------------------------------------------------
